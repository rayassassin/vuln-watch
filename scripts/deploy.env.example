# 部署配置模板 —— 复制到 ~/.config/vuln-watch/deploy.env 后填真值
#
#   mkdir -p ~/.config/vuln-watch
#   cp scripts/deploy.env.example ~/.config/vuln-watch/deploy.env
#   chmod 600 ~/.config/vuln-watch/deploy.env
#
# 这个文件永远不要提交（.gitignore 已包含 deploy.env）。
# 也可以用环境变量代替，环境变量优先级更高。

# ---- 必填：SSH 连接信息 ----
VW_SSH_HOST=203.0.113.10
VW_SSH_PORT=22
VW_SSH_USER=deploy
VW_SSH_PASS=change-me

# ---- 可选：远程目录 ----
# 应用部署目录；不填默认 /opt/vuln-watch
VW_REMOTE_DIR=/opt/vuln-watch
# 传输中转目录；不填默认取 VW_REMOTE_DIR 的同级 _releases
#VW_RELEASES_DIR=/opt/_staging

# ---- 可选：自建应用通道的凭据文件与收件人来源 ----
# 留空则 run.sh 不注入这两个变量，collect.py 会退化为自动解析授权人身份
#VW_WECOM_APP_ENV=/path/to/wecom_app.env
#VW_WECOM_FEEDS=/path/to/feeds.json

# ---- 可选：Pages 发布 token 文件（cron-run.sh 读取）----
# 不填默认 <VW_REMOTE_DIR>/.pages_token
#VW_PAGES_TOKEN_FILE=/opt/vuln-watch/.pages_token

# ---- 可选：两次 SSH 连接之间的最小间隔（秒，默认 3.5）----
# 服务器若有「60 秒 N 个新连接就丢包」的防暴破规则，别把这个值调得太小，
# 否则会被自己的防护规则拦掉，症状是 ping 通但所有端口连不上。
#VW_SSH_MIN_GAP=3.5
