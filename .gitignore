# 运行状态：记录已推送水位，每台机器各自一份，不要提交
state.db
state.db-journal
state.db-wal

# 运行日志
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# macOS
.DS_Store

# 本机覆盖配置（放自己的 webhook / chat_id，不入库）
vuln-watch.local.yaml

# 部署配置：含主机、账号、密码，只存在本机 ~/.config/vuln-watch/ 或临时 export
deploy.env

# 网页运行时数据：由 collect.py 现场生成，服务器/本机各自维护
web/data.json

# Pages 发布指纹：记录上一次发布的内容，内容没变就不重复推
.pages_state

# Pages 发布用 fine-grained PAT，只在服务器本地存在
.pages_token
