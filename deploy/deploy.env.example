# 看板容器的运行参数。复制成 .env 后按实际填，.env 不进仓库。
#
#   cp deploy.env.example .env

# 对外端口（映射到容器内 8080）。备案下来之前就用这个访问。
PUBLIC_PORT=8080

# 域名。还没解析/没备案时保持 _ （接受任意 Host），
# 填了之后只有该域名能访问，用 IP 访问会落到这个默认 server 上（仍可访问，不报错）。
SERVER_NAME=_

# 采集输出目录（宿主路径），容器只读挂载这个目录
WEB_ROOT=/opt/vuln-watch/web

# 企微回调上游：宿主上那个 python 回调服务让出 80 后监听的地址
CALLBACK_UPSTREAM=host.docker.internal:18080
